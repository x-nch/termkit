#!/usr/bin/env bash
# ~/.bashrc — TermKit-managed bash configuration
# Non-login interactive shells only.

# Not interactive? Exit immediately.
[[ $- != *i* ]] && return

# ── TermKit shared layer ──────────────────────────────────────────────────────
_TERMKIT_SHELL="${HOME}/.config/termkit/shell"
[[ -f "${_TERMKIT_SHELL}/env.sh"       ]] && source "${_TERMKIT_SHELL}/env.sh"
[[ -f "${_TERMKIT_SHELL}/aliases.sh"   ]] && source "${_TERMKIT_SHELL}/aliases.sh"
[[ -f "${_TERMKIT_SHELL}/functions.sh" ]] && source "${_TERMKIT_SHELL}/functions.sh"
unset _TERMKIT_SHELL

# ── bash-specific aliases file ────────────────────────────────────────────────
[[ -f "$HOME/.bash_aliases" ]] && source "$HOME/.bash_aliases"

# ── History ───────────────────────────────────────────────────────────────────
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT="%F %T "
shopt -s histappend     # Append; don't overwrite
shopt -s cmdhist        # Multi-line commands as one history entry

# ── Shell options ─────────────────────────────────────────────────────────────
shopt -s checkwinsize   # Update LINES/COLUMNS after each command
shopt -s extglob        # Extended pattern matching
shopt -s globstar       # ** recursive glob
shopt -s autocd  2>/dev/null || true  # bash 4+
shopt -s dirspell 2>/dev/null || true

# ── Completion ────────────────────────────────────────────────────────────────
if ! shopt -oq posix; then
    if   [[ -f /usr/share/bash-completion/bash_completion ]]; then
        source /usr/share/bash-completion/bash_completion
    elif [[ -f /etc/bash_completion ]]; then
        source /etc/bash_completion
    fi
fi

# ── Prompt ────────────────────────────────────────────────────────────────────
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    # Minimal fallback prompt
    PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
fi

# ── Local overrides (never committed) ─────────────────────────────────────────
[[ -f "$HOME/.bashrc.local" ]] && source "$HOME/.bashrc.local"
[[ -f "${TERMKIT_CONFIG:-$HOME/.config/termkit}/bashrc.local" ]] \
    && source "${TERMKIT_CONFIG:-$HOME/.config/termkit}/bashrc.local"
