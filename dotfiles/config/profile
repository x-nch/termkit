# ~/.profile: executed by the command interpreter for login shells.
# This file is read by all shells, including bash, sh, ksh, and zsh.

# TermKit Profile Configuration
export TERMKIT_VERSION="1.0.0"
export TERMKIT_CONFIG="$HOME/.config/termkit"

# Set default umask
umask 022

# Set default text editor if not already set
if [ -z "$EDITOR" ]; then
    if command -v vim >/dev/null 2>&1; then
        export EDITOR='vim'
    elif command -v nano >/dev/null 2>&1; then
        export EDITOR='nano'
    else
        export EDITOR='vi'
    fi
fi

# Set visual editor to match text editor
if [ -z "$VISUAL" ]; then
    export VISUAL="$EDITOR"
fi

# Set default pager
if [ -z "$PAGER" ]; then
    export PAGER='less'
fi

# Set locale
if [ -z "$LANG" ]; then
    export LANG='en_US.UTF-8'
fi

if [ -z "$LC_ALL" ]; then
    export LC_ALL='en_US.UTF-8'
fi

# Set timezone if not already set
if [ -z "$TZ" ]; then
    export TZ=':/etc/localtime'
fi

# Add local bin directories to PATH
if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Add go bin directory to PATH
if [ -d "$HOME/go/bin" ]; then
    PATH="$HOME/go/bin:$PATH"
fi

# Add cargo bin directory to PATH
if [ -d "$HOME/.cargo/bin" ]; then
    PATH="$HOME/.cargo/bin:$PATH"
fi

# Add user bin directory to PATH
if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi

# Add sbin directories to PATH for administrators
if [ -d "/usr/local/sbin" ]; then
    PATH="/usr/local/sbin:$PATH"
fi

if [ -d "/usr/sbin" ]; then
    PATH="/usr/sbin:$PATH"
fi

# Add snap packages to PATH
if [ -d "/snap/bin" ]; then
    PATH="/snap/bin:$PATH"
fi

# Add Android SDK tools if available
if [ -d "$HOME/Android/Sdk/platform-tools" ]; then
    PATH="$HOME/Android/Sdk/platform-tools:$PATH"
fi

# Add Java development tools
if [ -d "/usr/lib/jvm/default-java/bin" ]; then
    PATH="/usr/lib/jvm/default-java/bin:$PATH"
fi

# Set manpath
if [ -z "$MANPATH" ]; then
    export MANPATH="/usr/local/man:/usr/share/man"
fi

# Set infopath for info documentation
if [ -z "$INFOPATH" ]; then
    export INFOPATH="/usr/local/info:/usr/share/info"
fi

# Python development
if [ -z "$PYTHONPATH" ]; then
    export PYTHONPATH="$HOME/.local/lib/python3/site-packages"
else
    export PYTHONPATH="$PYTHONPATH:$HOME/.local/lib/python3/site-packages"
fi

# Node.js development
if [ -z "$NODE_PATH" ]; then
    export NODE_PATH="$HOME/.local/lib/node_modules"
fi

# Go development
if [ -z "$GOPATH" ]; then
    export GOPATH="$HOME/go"
fi

# Rust development
if [ -z "$RUSTUP_HOME" ]; then
    export RUSTUP_HOME="$HOME/.rustup"
fi

if [ -z "$CARGO_HOME" ]; then
    export CARGO_HOME="$HOME/.cargo"
fi

# Java development
if [ -z "$JAVA_HOME" ]; then
    if [ -d "/usr/lib/jvm/default-java" ]; then
        export JAVA_HOME="/usr/lib/jvm/default-java"
    elif [ -d "/usr/lib/jvm/java-11-openjdk-amd64" ]; then
        export JAVA_HOME="/usr/lib/jvm/java-11-openjdk-amd64"
    elif [ -d "/usr/lib/jvm/java-8-openjdk-amd64" ]; then
        export JAVA_HOME="/usr/lib/jvm/java-8-openjdk-amd64"
    fi
fi

# Android development
if [ -z "$ANDROID_HOME" ]; then
    if [ -d "$HOME/Android/Sdk" ]; then
        export ANDROID_HOME="$HOME/Android/Sdk"
        export ANDROID_SDK_ROOT="$ANDROID_HOME"
    fi
fi

# Node Version Manager (NVM)
if [ -d "$HOME/.nvm" ]; then
    export NVM_DIR="$HOME/.nvm"
    # Load NVM if the script exists
    if [ -s "$NVM_DIR/nvm.sh" ]; then
        # Defer loading NVM to improve shell startup time
        # It will be loaded when first used
        # source "$NVM_DIR/nvm.sh"
        # [ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
        
        # Create lazy loading wrapper for nvm
        nvm() {
            unset -f nvm
            [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
            nvm "$@"
        }
    fi
fi

# Ruby Version Manager (RVM)
if [ -d "$HOME/.rvm" ]; then
    export PATH="$PATH:$HOME/.rvm/bin"
    # Defer loading RVM for performance
    rvm() {
        unset -f rvm
        [ -s "$HOME/.rvm/scripts/rvm" ] && source "$HOME/.rvm/scripts/rvm"
        rvm "$@"
    }
fi

# Ruby environment (rbenv)
if [ -d "$HOME/.rbenv" ]; then
    export PATH="$HOME/.rbenv/bin:$PATH"
    # Defer loading rbenv for performance
    rbenv() {
        unset -f rbenv
        eval "$(rbenv init -)"
        rbenv "$@"
    }
fi

# Python virtualenvwrapper
if command -v virtualenvwrapper.sh >/dev/null 2>&1; then
    export WORKON_HOME="$HOME/.virtualenvs"
    export PROJECT_HOME="$HOME/projects"
    # Defer loading virtualenvwrapper for performance
    mkvirtualenv() {
        unset -f mkvirtualenv
        source /usr/local/bin/virtualenvwrapper.sh
        mkvirtualenv "$@"
    }
fi

# Machine-specific settings
if [ -f "$HOME/.profile.local" ]; then
    source "$HOME/.profile.local"
fi

# TermKit specific settings
if [ -f "$TERMKIT_CONFIG/profile.local" ]; then
    source "$TERMKIT_CONFIG/profile.local"
fi

# If running bash, source bashrc
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
        source "$HOME/.bashrc"
    fi
fi

# If running zsh, source zshrc
if [ -n "$ZSH_VERSION" ]; then
    if [ -f "$HOME/.zshrc" ]; then
        source "$HOME/.zshrc"
    fi
fi

# Display system information on first login
if [ -z "$TERMKIT_WELCOME_SHOWN" ]; then
    export TERMKIT_WELCOME_SHOWN=1
    
    # Only show welcome in interactive sessions
    if [ -t 1 ]; then
        # Display message of the day if it exists
        if [ -f "/etc/motd" ]; then
            cat /etc/motd
        fi
        
        # Display custom message of the day if it exists
        if [ -f "$HOME/.motd" ]; then
            cat "$HOME/.motd"
        fi
    fi
fi

# End of TermKit Profile Configuration