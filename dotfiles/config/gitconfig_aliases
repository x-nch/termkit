# Add a custom command that looks like time but is actually git time
time = !git log -1 --format=\"%ci\"

# Custom commit commands
commit-with-issue = "!f() { git commit -m \"issue-$1: ${@:2}\"; }; f"
commit-with-ticket = "!f() { git commit -m \"$1: ${@:2}\"; }; f"

# Better log aliases
log-simple = log --pretty=format:'%h %s'
log-full = log --pretty=format:'%h - %an, %ar : %s'
log-branch = log --graph --pretty=oneline --abbrev-commit

# Show files modified in each commit
log-file-changes = log --name-status --pretty=format:'%h %s'

# Show file history with content
log-file-content = log -p --follow

# Show which commits changed which files
what-changed = whatchanged --stat --summary

# Quick status
short-status = status --short --branch

# Quick diff
show-diff = diff --stat
show-diff-cached = diff --cached --stat

# Branch management
branch-list = branch -a
branch-remote = branch -r
branch-local = branch -l

# Tag management
tag-list = tag -l
tag-lightweight = tag -l "*[0-9].[0-9]*"
tag-annotated = tag -l "*[0-9].[0-9]*" -n1

# Remote management
remote-list = remote -v
remote-show = !git remote show origin
remote-prune = !git remote prune origin

# Stash management
stash-list = stash list
stash-show = !git stash show -p stash@{0}
stash-pop = stash pop
stash-clear = stash clear

# Clean working directory
clean-dry-run = clean -n
clean-all = clean -fdx

# Reset commands
reset-soft = reset --soft HEAD~1
reset-mixed = reset --mixed HEAD~1
reset-hard = reset --hard HEAD~1

# Merge and rebase helpers
merge-no-ff = merge --no-ff
rebase-interactive = !git rebase -i HEAD~10

# Cherry-pick helpers
cherry-pick-no-commit = cherry-pick --no-commit

# Bisect helpers
bisect-start = bisect start
bisect-bad = bisect bad
bisect-good = bisect good

# Submodule management
submodule-update = submodule update --init --recursive
submodule-status = submodule status

# Show commit changes
show-commit = show --stat --pretty=format:\"%H %s%n%n%b%nAuthor: %an <%ae>%nDate: %ai%n\"

# Find commit by message
find-by-message = !git log --grep=\"$1\" --oneline

# Find commit by author
find-by-author = !git log --author=\"$1\" --oneline

# Show commit statistics
stats-by-author = shortlog -sn --all
stats-by-file = git log --stat --oneline

# Performance and maintenance
gc-aggressive = gc --aggressive --prune=now
prune-all = !git prune --expire=now && git reflog expire --expire=now --all

# Security checks
verify-commit = !git verify-commit \"$1\"
verify-tag = !git verify-tag \"$1\"

# Show repository size
repo-size = !git count-objects -vH

# Show largest objects
largest-objects = !git rev-list --objects --all | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | sed -n 's/^blob //p' | sort --numeric-sort --key=2 | tail -10

# Search in commits
search-commits = !git log --all --grep=\"$1\"
search-diffs = !git log --all -p -S \"$1\"
search-content = !git log --all --grep=\"$1\" --oneline

# Create release tag
create-release = !f() { git tag -a v$1 -m \"Release version $1\"; git push origin v$1; }; f

# Show branch graph
branch-graph = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

# Show last commit details
last-commit = show -1 --stat
last-commit-full = show -1 --show-signature

# Show untracked files
untracked = status --porcelain | grep '^??'

# Show ignored files
ignored = ls-files --others -i --exclude-standard

# Show all branches with latest commit
branch-status = !git branch -vv

# Quick add and commit
quick-add = add -A
quick-commit = !git add -A && git commit -m \"$1\"

# Undo last commit (keep changes)
undo-last = reset --soft HEAD~1

# Undo last commit (discard changes)
undo-hard = reset --hard HEAD~1

# Find broken symlinks
broken-symlinks = !find . -type l -exec test ! -e {} \; -print

# Show commit per day
commits-per-day = !git log --pretty=format:'%ad' --date=format:'%Y-%m-%d' | sort | uniq -c

# Show working directory statistics
work-stats = !git status --porcelain | awk '{print $1}' | sort | uniq -c

# Search and replace in repo
search-replace = !f() { git grep -l \"$1\" | xargs sed -i \"s/$1/$2/g\"; }; f

# Export commit history
export-history = !git log --pretty=format:'%H|%an|%ae|%ad|%s' --date=iso

# Import commits from file
import-commits = !f() { while IFS='|' read hash author email date subject; do git commit --author=\"$author <$email>\" --date=\"$date\" -m \"$subject\"; done < \"$1\"; }; f

# Create hotfix branch
create-hotfix = !f() { git checkout -b hotfix/$1 main; }; f

# Create feature branch
create-feature = !f() { git checkout -b feature/$1 develop; }; f

# Merge feature to develop
merge-feature = !f() { git checkout develop; git merge --no-ff feature/$1; git branch -d feature/$1; }; f

# Complete release workflow
release-finish = !f() { git checkout main; git merge --no-ff develop; git tag -a v$1 -m \"Release version $1\"; git checkout develop; git merge main; git push origin main develop; git push origin v$1; }; f

# Show project statistics
project-stats = !git shortlog -sn --all --no-merges

# Show commit frequency by author
commit-frequency = !git log --pretty=format:'%an' | sort | uniq -c | sort -nr

# Show file change frequency
file-changes = !git log --name-only --pretty=format:'' | sort | uniq -c | sort -nr

# Show repository age
repo-age = !git log --reverse --format='%cr' | head -n 1

# Show most active days
active-days = !git log --pretty=format:'%ad' --date=format:'%Y-%m-%d' | sort -u | wc -l

# Find duplicate commits
duplicate-commits = !git log --all --pretty=format:'%s' | sort | uniq -d

# Show merge conflict history
conflict-history = !git log --grep=\"conflict\" --oneline