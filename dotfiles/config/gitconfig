# Git configuration for TermKit

[user]
    # Set your name and email
    # name = Your Name
    # email = your.email@example.com

[core]
    editor = vim
    pager = less -FRSX
    autocrlf = input
    whitespace = space-before-tab,indent-with-non-tab,trailing-space
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = simple

[branch]
    autosetuprebase = always

[merge]
    conflictstyle = diff3

[diff]
    algorithm = patience
    mnemonicprefix = true
    renames = true

[log]
    decorate = short
    showSignature = true

[status]
    showUntrackedFiles = normal

[alias]
    # Enhanced status and log
    st = status
    s = status -s
    co = checkout
    br = branch
    ci = commit
    cia = commit --amend
    ciaa = commit --amend --no-edit
    di = diff
    dc = diff --cached
    
    # Log aliases
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
    last = log -1 HEAD
    lastn = log -n
    
    # Show commits since last pull
    new = log HEAD@{1}..HEAD@{0}
    
    # Find commits referencing a bug
    bug = log --grep=bug --grep=fixed --grep=fix --grep=closed --oneline
    
    # Find commits with tests
    test = log --grep=test --grep=tests --oneline
    
    # Working with branches
    pom = push origin main
    pod = push origin develop
    
    # Show files modified in a commit
    show-files = show --name-only --pretty=format:""
    
    # List files that changed between two branches/commits
    changed = diff --name-status
    
    # Show commit content without metadata
    show-content = show --format="" --no-patch
    
    # Unstage files
    unstage = reset HEAD
    
    # Remove deleted files from index
    rm-deleted = !git rm $(git ls-files --deleted)
    
    # Show commit message template
    template = !echo '<type>(<scope>): <subject>' && echo '' && echo '<body>' && echo '' && echo '<footer>'
    
    # Interactive rebase with last N commits
    rebase-last = !git rebase -i HEAD~$(git log --oneline | head -n ${1:-5} | wc -l)
    
    # Find commit by message
    find = log --grep="$1" --oneline
    
    # Show commit stats
    stats = shortlog -sn --all

[rerere]
    enabled = true

[sendemail]
    smtpEncryption = tls
    smtpServer = smtp.gmail.com
    smtpServerPort = 587
    # Configure your email settings
    # smtpUser = your.email@gmail.com

[web]
    browser = firefox

[help]
    autocorrect = 20

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# GitHub integration
[github]
    user = # your-username

# GitLab integration
[gitlab]
    user = # your-username

# Custom coloring
[color "branch"]
    current = yellow reverse
    local = green
    remote = cyan

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red
    new = green
    whitespace = red reverse

[color "status"]
    added = green
    changed = yellow
    untracked = cyan
    branch = yellow
    header = cyan

# Platform-specific settings
[osx-cred-helper]
    credential = osxkeychain

[windows-cred-helper]
    credential = manager

[linux-cred-helper]
    credential = cache --timeout=3600

# Large file handling
[lfs]
    # Basic LFS file types
    track = "*.zip"
    track = "*.gz"
    track = "*.tar.gz"
    track = "*.jar"
    track = "*.war"
    track = "*.ear"
    track = "*.nar"
    track = "*.dmg"
    track = "*.pkg"
    track = "*.exe"
    track = "*.msi"
    track = "*.deb"
    track = "*.rpm"
    track = "*.img"
    track = "*.iso"
    track = "*.bin"
    track = "*.pdf"
    track = "*.psd"
    track = "*.ai"
    track = "*.sketch"
    track = "*.mov"
    track = "*.mp4"
    track = "*.avi"
    track = "*.mkv"
    track = "*.flv"
    track = "*.webm"
    track = "*.mp3"
    track = "*.wav"
    track = "*.flac"
    track = "*.ogg"
    track = "*.aac"

# Credential helper based on platform
[credential]
    # Use appropriate helper based on platform
    # helper = # Set based on your platform (osxkeychain, manager, cache, etc.)

# Security settings
[transfer]
    fsckobjects = true

[receive]
    fsckobjects = true

# Performance settings
[pack]
    deltaCacheSize = 1g
    windowMemory = 1g
    threads = 4
    indexVersion = 2
    compression = 9

[gc]
    auto = 256
    autoDetach = false

[repack]
    usedeltabaseoffset = true

# Maintenance
[maintenance]
    repo = .