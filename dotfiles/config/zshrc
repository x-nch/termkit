# ~/.zshrc: TermKit Dotfiles Version
# Enhanced ZSH configuration with modern tooling

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Source dotfiles integration
if [[ -f "$HOME/.config/termkit/bash-integration.sh" ]]; then
    source "$HOME/.config/termkit/bash-integration.sh"
fi

# TermKit dotfiles environment variables
export TERMKIT_VERSION="3.0.0"
export TERMKIT_DOTFILES_DIR="$HOME/nexi/termkit/dotfiles"

# ZSH-specific enhancements
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# Local customizations (will override dotfiles)
if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi

# End of TermKit Dotfiles zshrc