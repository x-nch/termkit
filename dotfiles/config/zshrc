# ~/.zshrc — TermKit-managed zsh configuration
# (No shebang: zshrc is sourced, not executed)

# ── TermKit shared layer ──────────────────────────────────────────────────────
_TERMKIT_SHELL="${HOME}/.config/termkit/shell"
[[ -f "${_TERMKIT_SHELL}/env.sh"       ]] && source "${_TERMKIT_SHELL}/env.sh"
[[ -f "${_TERMKIT_SHELL}/aliases.sh"   ]] && source "${_TERMKIT_SHELL}/aliases.sh"
[[ -f "${_TERMKIT_SHELL}/functions.sh" ]] && source "${_TERMKIT_SHELL}/functions.sh"
unset _TERMKIT_SHELL

# ── History ───────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history
setopt inc_append_history
setopt extended_history
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt hist_ignore_space
setopt hist_verify

# ── Shell options ─────────────────────────────────────────────────────────────
setopt auto_cd
setopt cdablevars
setopt pushd_ignore_dups
setopt pushdminus
setopt interactive_comments
setopt no_beep
setopt extended_glob
setopt prompt_subst

# ── Completion ────────────────────────────────────────────────────────────────
autoload -Uz compinit
compinit -d ~/.zcompdump

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' format ' %F{green}-- %d --%f'
zstyle ':completion:*' verbose yes
zstyle ':completion:*' matcher-list \
    'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'

# ── Key bindings ──────────────────────────────────────────────────────────────
bindkey -e

# Arrow-key history search bound to prefix
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

bindkey '^R'    history-incremental-search-backward
bindkey '^[[3~' delete-char
bindkey '^[[H'  beginning-of-line
bindkey '^[[F'  end-of-line
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# ── Prompt ────────────────────────────────────────────────────────────────────
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
else
    autoload -Uz promptinit && promptinit
    prompt adam1
fi

# ── Local overrides (never committed) ─────────────────────────────────────────
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
[[ -f "${TERMKIT_CONFIG:-$HOME/.config/termkit}/zshrc.local" ]] \
    && source "${TERMKIT_CONFIG:-$HOME/.config/termkit}/zshrc.local"
