# Git configuration for TermKit v3.0

[user]
    # Set your name and email
    # name = Your Name
    # email = your.email@example.com

[core]
    editor = nvim
    pager = delta
    autocrlf = input
    whitespace = space-before-tab,indent-with-non-tab,trailing-space
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default = simple

[branch]
    autosetuprebase = always

[merge]
    conflictstyle = diff3

[diff]
    algorithm = patience
    mnemonicprefix = true
    renames = true

[log]
    decorate = short
    showSignature = true

[status]
    showUntrackedFiles = normal

[alias]
    st = status -s
    co = checkout
    ci = commit
    a = add
    d = diff
    ds = diff --staged
    dp = diff --staged --word-diff
    lg = log --oneline --graph -10
    llg = log --oneline --graph -20
    tree = log --graph --pretty=format:'%C(yellow)%h%Creset -%C(yellow)%d%Creset %s %C(green)(%cr) %C(bold blue)<%an>%Creset'
    unstage = reset HEAD
    last = log -1 HEAD
    lastp = log -1 -p HEAD
    amend = commit --amend
    who = shortlog -sn
    cleanup = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"
    aliases = "!git config --get-regexp 'alias\\.' | sed -re 's/^alias\\.(\\w+)[ ]+(.*)$/\\1=\\2/'"
    recent = for-each-ref --sort=committerdate --format='%(refname:short) %(committerdate:relative) %(subject)' --count=10

# Delta configuration
[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true
    file-style = bold
    file-decoration-style = blue ol:
    hunk-style = bold
    syntax-theme = Monokai Extended

[interactive]
    diffFilter = delta --color-only

# LFS configuration
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    required = true

# Platform-specific settings
[osx-cred-helper]
    credential = osxkeychain

[linux-cred-helper]
    credential = cache --timeout=3600